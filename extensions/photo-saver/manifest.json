{
  "manifest_version": 3,
  "name": "페이지 사진 받기",
  "version": "1.6.0",
  "description": "보고 있는 페이지의 사진을 한꺼번에 받거나, 세로로 이어 붙여 한 장으로 받습니다.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "이 페이지 사진 받기",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "downloads", "offscreen"],
  "host_permissions": ["<all_urls>"]
}
