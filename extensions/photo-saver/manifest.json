{
  "manifest_version": 3,
  "name": "페이지 도우미",
  "version": "1.31.0",
  "description": "보고 있는 페이지의 사진·영상을 한꺼번에 받거나 세로로 이어 붙여 받고, 오른쪽 클릭을 막아 둔 페이지를 풀고, 보기 싫은 부분을 숨기고, 고른 글자나 복사한 글로 구글 검색이나 정해 둔 주소를 엽니다.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "페이지 도우미",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["hide-watch.js", "select-button.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": ["activeTab", "scripting", "downloads", "offscreen", "sidePanel", "storage", "contextMenus", "clipboardRead"],
  "host_permissions": ["<all_urls>"]
}
